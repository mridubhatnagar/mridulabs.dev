---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Contentflo",
    date: "April 2026",
    description: "AI content workflow in Slack -generates topics, captions, and images with team review built in.",
    live: "https://contentflo.mridulabs.dev",
    github: null,
    caseStudy: null,
  },
  {
    name: "SystemsFeed",
    date: "April 2026",
    description: "AI reading layer on top of engineering blogs -summaries, tags, prerequisites, and ELI5.",
    live: "https://enggfeed.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/enggfeed",
    caseStudy: null,
  },
  {
    name: "Prepit",
    date: "March 2026",
    description: "RAG-based knowledge base for interview prep -built end to end.",
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
  },
];
---

<BaseLayout title="Projects · Mridu">
  <h2>Projects</h2>
  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="date">{p.date}</span>
        </div>
        <p class="desc">{p.description}</p>
        <div class="links">
          {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {p.caseStudy && <a href={p.caseStudy}>Case Study →</a>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .projects li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .date {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0;
    font-size: 14px;
  }

  .links {
    display: flex;
    gap: 20px;
    font-size: 13px;
    margin-top: 2px;
  }
</style>
