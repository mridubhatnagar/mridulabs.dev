---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    name: "JobPilot",
    date: "In progress",
    description: "Personal job search system -finds relevant JDs across platforms, scores each against the provided resume, with a career-coach layer exposed via MCP so it plugs into Claude, ChatGPT, and other AI clients.",
    tags: ["Python", "MCP", "FastMCP", "Google Drive API", "Apify", "LLM", "Docker", "Google Cloud Run", "GitHub Actions", "Claude Code"],
    live: null,
    github: "https://github.com/mridubhatnagar/jobfinder",
    caseStudy: null,
  },
  {
    name: "Contentflo",
    date: "April 2026",
    description: "AI content workflow in Slack -generates topics, captions, and images with team review built in.",
    tags: ["Python", "FastAPI", "Slack API", "Google OAuth", "LLM", "LangGraph", "Celery", "Docker", "DigitalOcean", "GitHub Actions", "Claude Code"],
    live: "https://contentflo.mridulabs.dev",
    github: null,
    caseStudy: null,
  },
  {
    name: "SystemsFeed",
    date: "April 2026",
    description: "AI reading layer on top of engineering blogs -summaries, tags, prerequisites, and ELI5.",
    tags: ["Python", "FastAPI", "Google OAuth", "LLM", "HTML", "CSS", "Alpine.js", "Embedding", "PgVector", "Postgres", "Redis", "Docker", "DigitalOcean", "GitHub Actions", "Claude Code"],
    live: "https://enggfeed.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/enggfeed",
    caseStudy: null,
  },
  {
    name: "Prepit",
    date: "March 2026",
    description: "RAG-based knowledge base for interview prep -built end to end.",
    tags: ["Python", "FastAPI", "Google OAuth", "LLM", "HTML", "CSS", "Alpine.js", "Weaviate", "Docker", "AWS EC2", "GitHub Actions", "Claude Code"],
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
  },
];
---

<BaseLayout title="Projects · Mridu">
  <h2>Projects</h2>
  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <div class="title-group">
            {p.github ? (
              <a href={p.github} class="name name-link" target="_blank" rel="noopener noreferrer">{p.name}</a>
            ) : (
              <span class="name">{p.name}</span>
            )}
            {p.live && <a class="meta-link" href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
            {p.caseStudy && <a class="meta-link" href={p.caseStudy}>Case Study →</a>}
          </div>
          <span class="date">{p.date}</span>
        </div>
        <p class="desc">{p.description}</p>
        {p.tags?.length > 0 && (
          <ul class="tags">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .projects > li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .title-group {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .name-link {
    color: var(--fg-strong);
  }

  .meta-link {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .date {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0;
    font-size: 14px;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 6px 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags li {
    font-size: 11px;
    color: var(--fg-muted);
    background: var(--border);
    padding: 2px 8px;
    border-radius: 4px;
    line-height: 1.6;
  }

</style>
