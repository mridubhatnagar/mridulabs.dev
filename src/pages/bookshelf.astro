---
import BaseLayout from "../layouts/BaseLayout.astro";

type Book = {
  title: string;
  author: string;
  date?: string;
  status: "read" | "reading" | "to-read";
  note?: string;
};

const books: Book[] = [
  {
    title: "Obviously Awesome",
    author: "April Dunford",
    date: "May 2026",
    status: "reading",
  },
  {
    title: "The Mom Test",
    author: "Rob Fitzpatrick",
    date: "April 2026",
    status: "read",
  },
];

const order = { reading: 0, read: 1, "to-read": 2 } as const;
const sorted = [...books].sort((a, b) => order[a.status] - order[b.status]);
---

<BaseLayout title="BookShelf · Mridu">
  <h2>BookShelf</h2>
  {sorted.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="books">
      {sorted.map((b) => (
        <li>
          <div class="row">
            <span class="title">{b.title}</span>
            <span class="status">{b.status}</span>
          </div>
          <div class="meta">
            <span>{b.author}</span>
            {b.date && <span class="date">{b.date}</span>}
          </div>
          {b.note && <p class="note">{b.note}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .empty {
    color: var(--fg-faint);
    font-size: 14px;
    margin: 0;
  }

  .books {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .books li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .title {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .status {
    font-size: 12px;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta {
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--fg-muted);
  }

  .date {
    color: var(--fg-faint);
  }

  .note {
    color: var(--fg-muted);
    margin: 4px 0 0;
    font-size: 14px;
  }
</style>
