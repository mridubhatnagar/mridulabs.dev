---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Prepit",
    year: "2026",
    description: "RAG-based knowledge base for interview prep — built end to end.",
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
  },
  {
    name: "Techinternals",
    year: "2026",
    description: "A place to know how products and features work under the hood. (Work in Progress)",
    live: null,
    caseStudy: null,
  },
];
---

<BaseLayout>
  <p class="bio">Backend developer with some frontend exposure. Enthusiastic about building products and understanding how systems work. AI has enabled me to think beyond the code — across architecture, product, and execution — and develop a systems thinking mindset.</p>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="year">{p.year}</span>
        </div>
        <p class="desc">{p.description}</p>
        <div class="links">
          {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {p.caseStudy && <a href={p.caseStudy}>Case Study →</a>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .bio {
    color: var(--fg-muted);
    margin: 0 0 48px;
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects li {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.2s ease;
  }

  .projects li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .year {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0 0 10px;
    font-size: 14px;
  }

  .links {
    display: flex;
    gap: 20px;
    font-size: 13px;
  }
</style>
