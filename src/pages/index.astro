---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Prepit",
    year: "2026",
    description: "RAG-based knowledge base for interview prep -built end to end.",
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
    challenges: [
      "Batch ingestion silently fell back to keyword search with no error -caught only via shell experiments.",
      "Deleting messages to manage context window cost meant losing training data -switched to session IDs instead.",
      "Hybrid search score can't measure semantic relevance -used near_vector distance separately for out-of-scope detection.",
    ],
  },
  {
    name: "SystemsFeed",
    year: "2026",
    description: "AI reading layer on top of engineering blogs -summaries, tags, prerequisites, and ELI5.",
    live: "https://enggfeed.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/enggfeed",
    caseStudy: null,
    challenges: [
      "Built tag normalization in layers: evals to measure quality, prompt refinement, semantic search for fuzzy duplicates, DB unique constraint for exact ones.",
    ],
  },
];
---

<BaseLayout>
  <p class="bio">Python backend developer with 7+ years of experience. Enthusiastic about building products and understanding how systems work. AI has enabled me to think beyond the code - across architecture, product, and execution - and develop a systems thinking mindset.</p>

  <div class="highlights">
    <h2>Work Highlights</h2>
    <ul class="achievements">
      <li>Built JWT-based source verification using ES256 algorithm to secure cross-app access for 40,000+ students.</li>
      <li>Built exam city edit module serving 37,000+ students across 3 programs, eliminating manual support team intervention.</li>
      <li>Added Celery-based async processing to settlement service, enabling it to handle peak loads of 8,000+ customers.</li>
      <li>Drove settlement success rate to 100% by reducing merchant escalations to zero and coordinating with Razorpay and other dependent internal tech teams.</li>
    </ul>
  </div>

  <h2>Side Projects</h2>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="year">{p.year}</span>
        </div>
        <p class="desc">{p.description}</p>
        {p.challenges && (
          <ul class="challenges">
            {p.challenges.map((c) => <li>{c}</li>)}
          </ul>
        )}
        <div class="links">
          {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {p.caseStudy && <a href={p.caseStudy}>Case Study →</a>}
        </div>
      </li>
    ))}
  </ul>

  <div class="tech-stack">
    <h2>Tech Stack</h2>
    <dl class="stack">
      <div>
        <dt>Languages</dt>
        <dd>Python, JavaScript</dd>
      </div>
      <div>
        <dt>Frameworks</dt>
        <dd>Flask, FastAPI</dd>
      </div>
      <div>
        <dt>Databases</dt>
        <dd>PostgreSQL, MySQL, Google Datastore, Redis, Weaviate</dd>
      </div>
      <div>
        <dt>Cloud / Deployment</dt>
        <dd>AWS EC2, Digital Ocean, Netlify, GitHub Actions</dd>
      </div>
      <div>
        <dt>Tools</dt>
        <dd>Git, Docker, Celery, Claude Code, Gemini CLI</dd>
      </div>
      <div>
        <dt>API Integrations</dt>
        <dd>OpenAI, Claude API, Slack, Razorpay, WebEngage, Gmail</dd>
      </div>
      <div>
        <dt>AI Engineering</dt>
        <dd>LLM Application Development, Agents, RAG Systems, LangGraph</dd>
      </div>
    </dl>
  </div>

  <div class="content-speaking">
    <h2>Speaking & Content</h2>
    <dl class="stack">
      <div>
        <dt>Conferences</dt>
        <dd>PyData Delhi, EuroPython, PyLadies meetups</dd>
      </div>
      <div>
        <dt>Content</dt>
        <dd>LinkedIn Learning, Twilio, egghead.io</dd>
      </div>
    </dl>
  </div>
</BaseLayout>

<style>
  .bio {
    color: var(--fg-muted);
    margin: 0 0 24px;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 0 20px;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 16px 0 20px;
  }

  .achievements {
    list-style: decimal;
    padding-left: 1.2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .achievements li {
    font-size: 14px;
    color: var(--fg-muted);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .stack div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .stack dt {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .stack dd {
    margin: 0;
    font-size: 14px;
    color: var(--fg-muted);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects li {
    padding: 8px 0;
  }

  .projects li:first-child {
    padding-top: 0;
  }


  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .year {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0 0 4px;
    font-size: 14px;
  }

  .challenges {
    list-style: disc;
    padding-left: 1.1rem;
    margin: 0 0 6px;
  }

  .challenges li {
    font-size: 13px;
    color: var(--fg-faint);
    line-height: 1.4;
    margin: 0;
    padding-block: 0;
  }

.links {
    display: flex;
    gap: 20px;
    font-size: 13px;
    flex-wrap: wrap;
    row-gap: 6px;
  }

  @media (max-width: 600px) {
    .stack div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

</style>
