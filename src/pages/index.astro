---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = [
  {
    name: "HumaraCart",
    year: "2026",
    description: "Shared household cart agent on WhatsApp built using Instamart's MCP server, for Swiggy Builders Club -keeps everyone's adds in one unified cart.",
    live: null,
    demo: "https://www.youtube.com/watch?v=I2IFtHbkLng",
    github: "https://github.com/mridubhatnagar/humaraCart",
    caseStudy: null,
    challenges: null,
  },
  {
    name: "Prepit",
    year: "2026",
    description: "RAG-based knowledge base for interview prep -built end to end.",
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
    challenges: [
      "Batch ingestion silently fell back to keyword search with no error -caught only via shell experiments.",
      "Deleting messages to manage context window cost meant losing training data -switched to session IDs instead.",
      "Hybrid search score can't measure semantic relevance -used near_vector distance separately for out-of-scope detection.",
    ],
  },
];
---

<BaseLayout>
  <p class="bio">Python backend developer with 7+ years of experience. Enthusiastic about building products and understanding how systems work. AI has enabled me to think beyond the code - across architecture, product, and execution - and develop a systems thinking mindset.</p>

  <p class="calendly">Open to new roles and conversations. <a href="https://calendly.com/mridubhatnagar" target="_blank" rel="noopener noreferrer" class="stat">Book a call ↗</a></p>

  <div class="highlights">
    <h2>Work Highlights</h2>
    <ul class="achievements">
      <li>Built JWT-based source verification using ES256 algorithm to secure cross-app access for <span class="stat">40,000+</span> students.</li>
      <li>Built exam city edit module serving <span class="stat">37,000+</span> students across 3 programs, eliminating manual support team intervention.</li>
      <li>Added Celery-based async processing to settlement service, enabling it to handle peak loads of <span class="stat">8,000+</span> customers.</li>
      <li>Drove settlement success rate to <span class="stat">100%</span> by reducing merchant escalations to zero and coordinating with Razorpay and other dependent internal tech teams.</li>
    </ul>
  </div>

  <h2>Side Projects</h2>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="year">{p.year}</span>
        </div>
        <p class="desc">{p.description}</p>
        {p.challenges && (
          <ul class="challenges">
            {p.challenges.map((c) => <li>{c}</li>)}
          </ul>
        )}
        <div class="links">
          {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
          {p.demo && <a href={p.demo} target="_blank" rel="noopener noreferrer">Demo ↗</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {p.caseStudy && <a href={p.caseStudy}>Case Study →</a>}
        </div>
      </li>
    ))}
  </ul>

  <div class="writing">
    <h2>Writing</h2>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <div class="row">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="date">
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            </span>
          </div>
        </li>
      ))}
    </ul>
    <a href="/blog" class="view-all">View all →</a>
  </div>

  <div class="tech-stack">
    <h2>Tech Stack</h2>
    <dl class="stack">
      <div>
        <dt>Languages</dt>
        <dd>Python, JavaScript</dd>
      </div>
      <div>
        <dt>Frameworks</dt>
        <dd>Flask, FastAPI</dd>
      </div>
      <div>
        <dt>Databases</dt>
        <dd>PostgreSQL, MySQL, Google Datastore, Redis, Weaviate</dd>
      </div>
      <div>
        <dt>Cloud / Deployment</dt>
        <dd>AWS EC2, Digital Ocean, Netlify, GitHub Actions</dd>
      </div>
      <div>
        <dt>Tools</dt>
        <dd>Git, Docker, Celery, Claude Code, Gemini CLI</dd>
      </div>
      <div>
        <dt>API Integrations</dt>
        <dd>OpenAI, Claude API, Slack, Razorpay, WebEngage, Gmail</dd>
      </div>
      <div>
        <dt>AI Engineering</dt>
        <dd>LLM Application Development, Agents, RAG Systems, LangGraph, MCP</dd>
      </div>
    </dl>
  </div>

  <div class="content-speaking">
    <h2>Speaking & Content</h2>
    <dl class="stack">
      <div class="conf-row">
        <dt>Conferences</dt>
        <dd>
          <ul class="conf-list">
            <li><a href="https://www.youtube.com/watch?v=Gb6sN7VYKog" target="_blank" rel="noopener noreferrer">Building a Bot for WhatsApp using Python and Flask ↗</a> at Women Who Code (Virtual), 2020 (<span class="stat">5,388</span> views)</li>
            <li><a href="https://www.youtube.com/watch?v=g5LNWqZw-yg" target="_blank" rel="noopener noreferrer">Rest API Integration with Python ↗</a> at Women Who Code (Virtual), 2020 (<span class="stat">4,245</span> views)</li>
            <li><a href="https://www.youtube.com/watch?v=1hy6YwsVZaU" target="_blank" rel="noopener noreferrer">Apache Airflow talk ↗</a> at PyData Delhi 2019 (<span class="stat">2.8k+</span> views)</li>
            <li><a href="https://www.youtube.com/watch?v=UkUY6cVxlLY" target="_blank" rel="noopener noreferrer">Object Internals in Python ↗</a> at EuroPython 2020 (international conference)</li>
            <li><a href="https://www.youtube.com/watch?v=c295s11XCVo&t=4080s" target="_blank" rel="noopener noreferrer">Memory address in Python ↗</a> at Remote Python Pizza Conference (Berlin), 2021 (international conference)</li>
            <li>+4 more talks at international Python community meetups</li>
          </ul>
        </dd>
      </div>
      <div>
        <dt>Content</dt>
        <dd><a href="https://www.linkedin.com/learning/python-data-structures-sets-and-frozen-sets-24926312" target="_blank" rel="noopener noreferrer">Sets & Frozen Sets ↗</a> (LinkedIn Learning, <span class="stat">6,799+</span> learners)</dd>
      </div>
    </dl>
  </div>
</BaseLayout>

<style>
  .bio {
    color: var(--fg-muted);
    margin: 0 0 24px;
  }

  .calendly {
    font-size: 13px;
    color: var(--fg-muted);
    margin: -14px 0 24px;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 0 20px;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 16px 0 20px;
  }

  .writing {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 16px 0 20px;
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .posts .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0;
  }

  .posts a {
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-strong);
  }

  .posts .date {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .view-all {
    align-self: flex-start;
    font-size: 12px;
    color: var(--fg-faint);
  }

  .achievements {
    list-style: decimal;
    padding-left: 1.2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .achievements li {
    font-size: 14px;
    color: var(--fg-muted);
  }

  .stat {
    font-weight: 600;
    color: var(--fg-strong);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .stack div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .stack dt {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .stack dd {
    margin: 0;
    font-size: 14px;
    color: var(--fg-muted);
  }

  .conf-row {
    align-items: start !important;
  }

  .conf-list {
    list-style: disc;
    padding-left: 1.1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .conf-list li {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects li {
    padding: 8px 0;
  }

  .projects li:first-child {
    padding-top: 0;
  }


  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .year {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0 0 4px;
    font-size: 14px;
  }

  .challenges {
    list-style: disc;
    padding-left: 1.1rem;
    margin: 0 0 6px;
  }

  .challenges li {
    font-size: 13px;
    color: var(--fg-faint);
    line-height: 1.4;
    margin: 0;
    padding-block: 0;
  }

.links {
    display: flex;
    gap: 20px;
    font-size: 13px;
    flex-wrap: wrap;
    row-gap: 6px;
  }

  @media (max-width: 600px) {
    .stack div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

</style>
