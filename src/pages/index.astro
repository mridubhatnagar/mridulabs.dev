---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "Prepit",
    year: "2026",
    description: "RAG-based knowledge base for interview prep -built end to end.",
    live: "https://prepit.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/prepwise",
    caseStudy: "/projects/prepit",
  },
  {
    name: "SystemsFeed",
    year: "2026",
    description: "Stay ahead of the Stack -curated engineering content to keep you sharp.",
    live: "https://enggfeed.mridulabs.dev",
    github: "https://github.com/mridubhatnagar/enggfeed",
    caseStudy: null,
  },
];
---

<BaseLayout>
  <p class="bio">Python backend developer with 7+ years of experience. Enthusiastic about building products and understanding how systems work. AI has enabled me to think beyond the code - across architecture, product, and execution - and develop a systems thinking mindset.</p>

  <div class="highlights">
    <h2>Work Highlights</h2>
    <ul class="achievements">
      <li>Owned development and maintenance of the settlement service, rolled out to 8,000+ customers.</li>
      <li>Automated GST reporting and invoice generation, reducing manual effort by 50%.</li>
      <li>Built bulk student marks upsert, eliminating repetitive manual uploads for the academic team.</li>
      <li>Built exam city edit module for international students, eliminating manual support team intervention.</li>
    </ul>
  </div>

  <div class="tech-stack">
    <h2>Tech Stack</h2>
    <dl class="stack">
      <div>
        <dt>Languages</dt>
        <dd>Python, JavaScript</dd>
      </div>
      <div>
        <dt>Frameworks</dt>
        <dd>Flask, FastAPI</dd>
      </div>
      <div>
        <dt>Databases</dt>
        <dd>PostgreSQL, MySQL, Google Datastore, Redis, Vector Databases</dd>
      </div>
      <div>
        <dt>Cloud / Deployment</dt>
        <dd>AWS EC2, Digital Ocean, Netlify, GitHub Actions</dd>
      </div>
      <div>
        <dt>Tools</dt>
        <dd>Git, Docker, Celery, Claude Code</dd>
      </div>
      <div>
        <dt>API Integrations</dt>
        <dd>OpenAI, Claude API, Slack, Razorpay</dd>
      </div>
      <div>
        <dt>AI Engineering</dt>
        <dd>LLM Application Development, Agents, RAG Systems</dd>
      </div>
    </dl>
  </div>

  <h2>Side Projects</h2>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="row">
          <span class="name">{p.name}</span>
          <span class="year">{p.year}</span>
        </div>
        <p class="desc">{p.description}</p>
        <div class="links">
          {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer">Live ↗</a>}
          {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {p.caseStudy && <a href={p.caseStudy}>Case Study →</a>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .bio {
    color: var(--fg-muted);
    margin: 0 0 24px;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 0 20px;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 0 20px;
  }

  .achievements {
    list-style: decimal;
    padding-left: 1.2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .achievements li {
    font-size: 14px;
    color: var(--fg-muted);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .stack div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .stack dt {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .stack dd {
    margin: 0;
    font-size: 14px;
    color: var(--fg-muted);
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects li {
    padding: 16px 0;
  }

  .projects li:first-child {
    padding-top: 0;
  }


  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .name {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 15px;
  }

  .year {
    font-size: 12px;
    color: var(--fg-faint);
  }

  .desc {
    color: var(--fg-muted);
    margin: 0 0 10px;
    font-size: 14px;
  }

.links {
    display: flex;
    gap: 20px;
    font-size: 13px;
  }
</style>
