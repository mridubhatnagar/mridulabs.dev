<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .intro h1 {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .intro p {
    color: var(--fg-muted);
    margin: 0 0 10px;
  }

  .socials {
    display: flex;
    gap: 16px;
    font-size: 13px;
  }

  h2 {
    margin-bottom: 24px;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 28px;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .role {
    font-weight: 500;
    color: var(--fg-strong);
    font-size: 14px;
  }

  .meta {
    font-size: 12px;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  li {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .project-desc {
    font-size: 14px;
    color: var(--fg-muted);
    margin: 0;
  }

  .links {
    display: flex;
    gap: 12px;
    font-size: 12px;
    white-space: nowrap;
  }

  .skills {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .skills dt {
    font-size: 12px;
    color: var(--fg-faint);
    padding-top: 1px;
  }

  .skills dd {
    margin: 0;
    font-size: 14px;
    color: var(--fg-muted);
  }
</style>
