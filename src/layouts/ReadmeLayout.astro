---
interface Props {
  title?: string;
}
const { title = "README" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="readme">
      <slot />
    </div>
  </body>
</html>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #24292f;
    background: #fff;
    margin: 0;
    padding: 0;
  }

  .readme {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px;
  }

  :global(h1) { font-size: 2em; font-weight: 600; border-bottom: 1px solid #d0d7de; padding-bottom: 0.3em; margin: 0 0 16px; }
  :global(h2) { font-size: 1.5em; font-weight: 600; border-bottom: 1px solid #d0d7de; padding-bottom: 0.3em; margin: 24px 0 16px; }
  :global(h3) { font-size: 1.25em; font-weight: 600; margin: 24px 0 16px; }
  :global(p)  { margin: 0 0 16px; }
  :global(ul), :global(ol) { padding-left: 2em; margin: 0 0 16px; }
  :global(li) { margin-bottom: 4px; }
  :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.875em; background: #f6f8fa; padding: 2px 5px; border-radius: 4px; }
  :global(pre) { background: #f6f8fa; padding: 16px; border-radius: 6px; overflow-x: auto; margin: 0 0 16px; }
  :global(pre code) { background: none; padding: 0; font-size: 0.875em; }
  :global(blockquote) { border-left: 4px solid #d0d7de; margin: 0 0 16px; padding: 0 16px; color: #656d76; }
  :global(hr) { border: none; border-top: 1px solid #d0d7de; margin: 24px 0; }
  :global(strong) { font-weight: 600; }
  :global(em) { font-style: italic; }
  :global(a) { color: #0969da; text-decoration: none; }
  :global(a:hover) { text-decoration: underline; }
</style>
