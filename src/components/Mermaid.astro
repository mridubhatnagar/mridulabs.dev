---
const { code, title } = Astro.props;
---

<figure class="diagram">
  {title && <figcaption>{title}</figcaption>}
  <pre class="mermaid">{code}</pre>
</figure>

<style>
  .diagram {
    margin: 0;
    overflow-x: auto;
  }

  figcaption {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--fg-faint);
    margin-bottom: 16px;
  }

  .mermaid {
    margin: 0;
    padding: 0;
    background: transparent;
  }
</style>
